# App
APP__LOGGING_LEVEL=INFO
APP__SERVICE_ID=ai_plot_generator

# Kafka
KAFKA__BOOTSTRAP_SERVERS=kafka:9092

# Analytics
ANALYTICS__KAFKA_TOPIC=llm.usage

# Postgres
POSTGRES__DB=clean-example
POSTGRES__HOST=db_pg
POSTGRES__PORT=5432

# Codex
CODEX__BASE_URL=http://codex-app-1:8000

# Redis (кэш Codex)
REDIS__URL=redis://redis:6379/0

# DeepSeek
DEEPSEEK__TEMPERATURE=0.9
DEEPSEEK__DIALOGUE_TEMPERATURE=1.0
DEEPSEEK__NOVEL_REASONING_EFFORT=high
DEEPSEEK__CHARACTER_REASONING_EFFORT=low
DEEPSEEK__ROADMAP_REASONING_EFFORT=low
DEEPSEEK__DIALOGUE_REASONING_EFFORT=low

# Тумблеры thinking mode: False выключает reasoning и его тарификацию.
DEEPSEEK__CHARACTER_THINK=False
DEEPSEEK__ROADMAP_THINK=False
DEEPSEEK__DIALOGUE_THINK=True

DEEPSEEK__BASE_URL=https://api.deepseek.com
